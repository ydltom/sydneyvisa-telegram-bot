# Telegram bot credentials
TELEGRAM_TOKEN=
CHAT_ID=
# Optional numeric chat ID allowed to use /ping; defaults to CHAT_ID.
COMMAND_CHAT_ID=

# Polling configuration
POLL_INTERVAL=300
REQUEST_TIMEOUT=30
# Caps client-generated backoff; Retry-After can override it, up to 24 hours.
MAX_RETRY_INTERVAL=3600
MANUAL_FETCH_COOLDOWN=60

# Optional: use an authorized compatible endpoint instead of the default.
MIGRATEMATE_API_URL=https://migratemate.co/api/visa-processing/interview-slots?consulate=SYDNEY

# Optional: only set this if the endpoint owner provides a Vercel automation token.
MIGRATEMATE_VERCEL_BYPASS_SECRET=
